<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- MCP HTTP 服务监听 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 前台保活 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 14+ 前台服务类型：本服务用途不属于系统预设类别，使用 specialUse 并声明用途 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ 包可见性：getLaunchIntentForPackage 需要声明查询 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidMcp">

        <!-- 首页：端口/Token 配置 + 权限引导 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 日志页面：按日期查看持久化运行日志 -->
        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:label="运行日志" />

        <!-- 设置页面：frpc 配置、宏管理、日志入口 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="设置" />

        <!-- 无障碍桥接服务：读 UI 树、注入手势、API30+ 截图 -->
        <service
            android:name=".AccessibilityBridge"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- MCP 前台服务：内嵌 HTTP 服务器 -->
        <service
            android:name=".McpForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="在本机提供 MCP 自动化 HTTP 服务，供可信内网客户端调用" />
        </service>

        <!-- 开机自启接收器 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
